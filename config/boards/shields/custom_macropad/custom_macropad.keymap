#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        ctrl_alt_w: ctrl_alt_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT>
                     , <&macro_tap &kp W>
                     , <&macro_release &kp LALT &kp LCTRL>;
        };
    };

    behaviors {
        lt_macro1: lt_macro1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&ctrl_alt_w>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &lt_macro1 1 0
                &kp E
                &lt 2 C_MUTE
                &kp C_PREV
                &kp C_PP
                &kp C_NEXT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            bindings = <
                &none
                &out OUT_USB
                &out OUT_BLE
                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_CLR
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        rgb_layer {
            bindings = <
                &to 0
                &none
                &rgb_ug RGB_EFF
                &rgb_ug RGB_HUI
                &rgb_ug RGB_BRI
                &rgb_ug RGB_BRD
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
