#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Main";
            bindings = <
                &lt 1 W         /* Key 1: 点按W / 按住层1 */
                &kp E           /* Key 2 */
                &kp C_MUTE      /* Key 3: 静音 */
                &kp C_PREV      /* Key 4: 上一曲 */
                &kp C_PP        /* Key 5: 播放/暂停 */
                &kp C_NEXT      /* Key 6: 下一曲 */
                &kp C_VOL_UP    /* 旋钮顺时针: 音量加 */
                &kp C_VOL_DN    /* 旋钮逆时针: 音量减 */
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
                &none           /* Key 1 */
                &out OUT_USB    /* Key 2: 切USB */
                &out OUT_BLE    /* Key 3: 切蓝牙 */
                &bt BT_SEL 0   /* Key 4: 蓝牙设备1 */
                &bootloader     /* Key 5: 进入引导 */
                &bt BT_CLR      /* Key 6: 清除配对 */
                &bt BT_NXT      /* 旋钮顺时针: 下一蓝牙 */
                &bt BT_PRV      /* 旋钮逆时针: 上一蓝牙 */
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
