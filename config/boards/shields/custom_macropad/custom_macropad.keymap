#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &lt 1 W         /* Key 1: 点按W / 按住层1 */
                &kp E           /* Key 2 */
                &kp C_MUTE      /* Key 3 */
                &kp C_PREV      /* Key 4 */
                &kp C_PP        /* Key 5 */
                &kp C_NEXT      /* Key 6 */
                &kp C_VOL_UP    /* 旋钮顺时针: 音量加 */
                &kp C_VOL_DN    /* 旋钮逆时针: 音量减 */
            >;
        };

        bt_layer {
            bindings = <
                &none           /* Key 1 */
                &out OUT_USB    /* Key 2 */
                &out OUT_BLE    /* Key 3 */
                &bt BT_SEL 0   /* Key 4 */
                &bootloader     /* Key 5 */
                &bt BT_CLR      /* Key 6 */
                &bt BT_NXT      /* 旋钮顺时针: 下一个蓝牙 */
                &bt BT_PRV      /* 旋钮逆时针: 上一个蓝牙 */
            >;
        };
    };
};
