#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Main";
            bindings = <
                &lt 1 W          /* pos 0: 点按W / 长按进层1(BT)   */
                &lt 2 W          /* pos 1: 点按W / 长按进层2(灯光) */
                &kp C_MUTE       /* pos 2: 静音                    */
                &kp C_PREV       /* pos 3: 上一曲                  */
                &kp C_PP         /* pos 4: 播放/暂停               */
                &kp C_NEXT       /* pos 5: 下一曲                  */
                &kp C_VOL_UP     /* pos 6: 旋钮 CW  音量+           */
                &kp C_VOL_DN     /* pos 7: 旋钮 CCW 音量-           */
                &kp C_VOL_UP     /* pos 8: 滑条 VOL+                */
                &kp C_VOL_DN     /* pos 9: 滑条 VOL-                */
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
                &none            /* pos 0 */
                &out OUT_USB     /* pos 1: 切USB    */
                &out OUT_BLE     /* pos 2: 切蓝牙   */
                &bt BT_SEL 0     /* pos 3: 蓝牙设备1 */
                &none            /* pos 4 */
                &bt BT_CLR       /* pos 5: 清除配对 */
                &bt BT_NXT       /* pos 6: 下一蓝牙 */
                &bt BT_PRV       /* pos 7: 上一蓝牙 */
                &kp C_VOL_UP     /* pos 8: 滑条 VOL+ (跨层保留)     */
                &kp C_VOL_DN     /* pos 9: 滑条 VOL-                */
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        rgb_layer {
            display-name = "RGB";
            bindings = <
                &rgb_ug RGB_TOG  /* pos 0: 背光开关     */
                &rgb_ug RGB_EFF  /* pos 1: 切换灯效     */
                &rgb_ug RGB_HUI  /* pos 2: 色相 +       */
                &rgb_ug RGB_HUD  /* pos 3: 色相 -       */
                &rgb_ug RGB_BRI  /* pos 4: 亮度 +       */
                &rgb_ug RGB_BRD  /* pos 5: 亮度 -       */
                &rgb_ug RGB_SPI  /* pos 6: 灯效速度 +   */
                &rgb_ug RGB_SPD  /* pos 7: 灯效速度 -   */
                &kp C_VOL_UP     /* pos 8: 滑条 VOL+    */
                &kp C_VOL_DN     /* pos 9: 滑条 VOL-    */
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
