#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Main";
            bindings = <
                &lt 1 W
                &kp E
                &kp C_MUTE
                &kp C_PREV
                &kp C_PP
                &kp C_NEXT
                &kp C_VOL_UP
                &kp C_VOL_DN
                &kp F13
                &kp F14
                &kp F15
                &kp F16
                &kp F17
                &kp F18
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
                &none
                &out OUT_USB
                &out OUT_BLE
                &bt BT_SEL 0
                &bootloader
                &bt BT_CLR
                &bt BT_NXT
                &bt BT_PRV
                &kp F13
                &kp F14
                &kp F15
                &kp F16
                &kp F17
                &kp F18
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
