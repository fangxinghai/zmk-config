/*
 * Custom Macropad Shield Overlay
 * MCU: nRF52840
 * 6 Keys + 1 Rotary Encoder (2 virtual keys) = 8 positions
 * 6x WS2812 backlight (P0.17, SPI3) → ZMK RGB underglow
 * P0.29 (AIN5) → 滑动变阻器 (ADC 模拟输入)   ← 临时占用，替换原状态灯
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan          = &kscan0;
        zmk,physical-layout = &physical_layout0;
        zmk,battery        = &vbatt;
        zmk,underglow      = &backlight_strip;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;              /* AIN2 = P0.04，电池分压 */
        output-ohms = <5100000>;
        full-ohms   = <(5100000 + 5100000)>;
    };

    ext_power {
        compatible     = "zmk,ext-power-generic";
        control-gpios  = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms  = <50>;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    direct_transform: direct_matrix_transform {
        compatible = "zmk,matrix-transform";
        rows    = <1>;
        columns = <8>;
        map     = <0 1 2 3 4 5 6 7>;
    };

    physical_layout0: physical_layout_0 {
        compatible   = "zmk,physical-layout";
        display-name = "Default Layout";
        transform    = <&direct_transform>;
        kscan        = <&kscan0>;
        keys =
            <&key_physical_attrs 100 100   0   0   0 0 0>,
            <&key_physical_attrs 100 100 100   0   0 0 0>,
            <&key_physical_attrs 100 100 200   0   0 0 0>,
            <&key_physical_attrs 100 100   0 100   0 0 0>,
            <&key_physical_attrs 100 100 100 100   0 0 0>,
            <&key_physical_attrs 100 100 200 100   0 0 0>,
            <&key_physical_attrs 100 100 350   0   0 0 0>,
            <&key_physical_attrs 100 100 350 100   0 0 0>
            ;
    };

    encoder: encoder_0 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps  = <24>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors    = <&encoder>;
        triggers-per-rotation = <24>;
    };

    /* ★ 供自定义模块读取 ADC 用 */
    zephyr,user {
        io-channels = <&adc 5>;   /* AIN5 = P0.29 → 滑动变阻器 */
    };
};

/* ============================================================
 * SPI3: 6 颗背光 WS2812, P0.17
 * ============================================================ */
&spi3 {
    compatible   = "nordic,nrf-spim";
    status       = "okay";
    pinctrl-0    = <&spi3_default>;
    pinctrl-1    = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    backlight_strip: ws2812@0 {
        compatible       = "worldsemi,ws2812-spi";
        label            = "WS2812_BACKLIGHT";
        reg              = <0>;
        spi-max-frequency = <4000000>;
        chain-length     = <6>;
        spi-one-frame    = <0x70>;
        spi-zero-frame   = <0x40>;
        color-mapping    = <LED_COLOR_ID_GREEN
                            LED_COLOR_ID_RED
                            LED_COLOR_ID_BLUE>;
    };
};

/* ============================================================
 * ADC: 启用 SAADC，配置 AIN5 (P0.29) 作为滑动变阻器输入
 * ============================================================ */
&adc {
    status = "okay";

    #address-cells = <1>;
    #size-cells    = <0>;

    /* 通道 5 → AIN5 (P0.29) */
    channel@5 {
        reg = <5>;
        zephyr,gain             = "ADC_GAIN_1_6";
        zephyr,reference        = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive   = <NRF_SAADC_AIN5>;
        zephyr,resolution       = <12>;
    };
};

/* ============================================================
 * pinctrl 配置（只保留 SPI3 背光）
 * ============================================================ */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };
};
